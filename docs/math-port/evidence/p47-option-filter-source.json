{
  "stage": "original ordinary-array/numeric-priority option binding observations",
  "rows": [
    {
      "label": "direct-and-tuple-order",
      "cpp": "auto a=e.array({e.fv,e.tuple(e.gv,1),e.fv});e.append(a);e.list.execute();return \"ok\";",
      "expected": "ok|ok|g:1,f:5,f:5|add:f:5/add:g:1/add:f:5/call:g:true/call:f:true/call:f:true"
    },
    {
      "label": "holes-and-inherited-slots",
      "cpp": "auto a=e.context.array(3),p=e.context.array();e.context.set(p,options::Key(u\"1\"),e.fv);e.context.setPrototype(a,p);e.context.set(a,options::Key(u\"2\"),e.gv);e.append(a);return \"ok\";",
      "expected": "ok|ok|U:5,f:5,g:5|add:U:5/add:f:5/add:g:5"
    },
    {
      "label": "live-array-growth",
      "cpp": "auto a=e.array({e.fv});e.list.hook=[&](auto,double){if(e.list.calls==1)e.context.set(a,options::Key(u\"1\"),e.gv);};e.append(a);return \"ok\";",
      "expected": "ok|ok|f:5,g:5|add:f:5/add:g:5"
    },
    {
      "label": "live-array-shrink",
      "cpp": "auto a=e.array({e.fv,e.gv});e.list.hook=[&](auto,double){e.context.set(a,options::Key(u\"length\"),1);};e.append(a);return \"ok\";",
      "expected": "ok|ok|f:5|add:f:5"
    },
    {
      "label": "captured-array-after-rebind",
      "cpp": "auto a=e.array({e.fv,e.gv});e.list.hook=[&](auto,double){a=e.array({e.gv});};e.append(a);return \"ok\";",
      "expected": "ok|ok|f:5,g:5|add:f:5/add:g:5"
    },
    {
      "label": "tuple-read-before-add",
      "cpp": "auto t=e.tuple(e.fv,7),a=e.array({t});e.list.hook=[&](auto,double){e.context.set(t,options::Key(u\"0\"),e.gv);e.context.set(t,options::Key(u\"1\"),9);};e.append(a);return \"ok\";",
      "expected": "ok|ok|f:7|add:f:7"
    },
    {
      "label": "getter-zero-before-one",
      "cpp": "auto t=e.context.array(2);e.getter(t,u\"0\",[&](){trace.push_back(\"get:0\");e.context.set(t,options::Key(u\"1\"),8);return e.fv;});e.append(e.array({t}));return \"ok\";",
      "expected": "ok|ok|f:8|get:0/add:f:8"
    },
    {
      "label": "getter-live-default-priority",
      "cpp": "auto t=e.context.array(2);e.getter(t,u\"0\",[&](){trace.push_back(\"get:0\");FunctionList::DEFAULTPRIORITY=11;return e.fv;});e.append(e.array({t,e.gv}));return \"ok\";",
      "expected": "ok|ok|f:11,g:11|get:0/add:f:11/add:g:11"
    },
    {
      "label": "indexed-get-after-add",
      "cpp": "auto a=e.context.array(2);e.context.set(a,options::Key(u\"0\"),e.fv);e.getter(a,u\"1\",[&](){trace.push_back(\"get:1\");return e.gv;});e.append(a);return \"ok\";",
      "expected": "ok|ok|f:5,g:5|add:f:5/get:1/add:g:5"
    },
    {
      "label": "getter-error-prefix",
      "cpp": "auto t=e.context.array(2);e.context.set(t,options::Key(u\"0\"),e.gv);e.getter(t,u\"1\",[&]()->options::Value{trace.push_back(\"get:1\");throw options::Exception(\"Error\",u\"priority\");});e.append(e.array({e.fv,t}));return \"ok\";",
      "expected": "Error|priority|THREW|f:5|add:f:5/get:1"
    },
    {
      "label": "function-alias-after-option-copy",
      "cpp": "auto d=e.context.object();e.context.set(d,options::Key(u\"pre\"),e.array({e.fv,e.fv}));auto out=e.context.object();std::array<options::Value,1> defs{d};options::defaultOptions(e.context,out,defs);e.append(e.context.get(out,options::Key(u\"pre\")));return \"ok\";",
      "expected": "ok|ok|f:5,f:5|add:f:5/add:f:5"
    },
    {
      "label": "canonical-function-binding",
      "cpp": "auto same=e.bindings.bind(e.f,e.adapter(e.f),u\"again\");return std::string(same==e.fv&&std::get<FunctionRef>(e.bindings.functionValue(same))==e.f?\"true\":\"false\");",
      "expected": "ok|true||"
    },
    {
      "label": "typed-context-call-same-canonical-body",
      "cpp": "e.append(e.array({e.fv}));auto record=e.list.begin().record();auto receiver=e.context.instance(e.context.constructor(u\"record\"),NativeObjectRef(record));auto result=e.context.call(std::get<options::ObjectRef>(e.fv.data),receiver);return std::holds_alternative<options::Undefined>(result.data)?\"U\":\"bad\";",
      "expected": "ok|U|f:5|add:f:5/call:f:true"
    },
