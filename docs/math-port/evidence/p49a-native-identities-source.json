    {
      "label": "same-node-canonical-handle",
      "cpp": "auto a=e.nodes.instance(e.node,e.klass,e.factory),b=e.nodes.instance(e.node,e.klass,e.factory);return yes(a==b)+\":\"+yes(e.nodes.resolve(a)==e.node);",
      "expected": "true:true"
    },
    {
      "label": "distinct-native-nodes",
      "cpp": "auto other=e.factory->create(\"mi\");auto a=e.nodes.instance(e.node,e.klass,e.factory),b=e.nodes.instance(other,e.klass,e.factory);return yes(a!=b)+\":\"+yes(e.nodes.resolve(b)==other);",
      "expected": "true:true"
    },
    {
      "label": "actual-factory-class-identity",
      "cpp": "auto nativeClass=e.factory->getNodeClass(\"mi\");auto value=e.classes.bind(nativeClass,e.klass);mml::MmlFactory second;return yes(e.classes.resolve(value)==second.getNodeClass(\"mi\"));",
      "expected": "true"
    },
    {
      "label": "node-alias-through-option-copy",
      "cpp": "auto node=e.nodes.instance(e.node,e.klass,e.factory);auto source=e.object({{u\"node\",node},{u\"array\",e.array({node,node})}});std::array<opts::Value,1> defs{source};auto result=opts::defaultOptions(e.context,e.context.object(),defs);auto array=e.get(result,u\"array\");return yes(e.get(result,u\"node\")==opts::Value(node))+\":\"+yes(e.get(array,u\"0\")==opts::Value(node))+\":\"+yes(array!=e.get(source,u\"array\"));",
      "expected": "true:true:true"
    },
    {
      "label": "factory-class-alias-through-option-copy",
      "cpp": "auto nativeClass=e.factory->getNodeClass(\"mi\");auto type=e.classes.bind(nativeClass,e.klass);auto source=e.object({{u\"items\",e.object({{u\"mi\",type}})}});std::array<opts::Value,1> defs{source};auto result=opts::defaultOptions(e.context,e.context.object(),defs);return yes(e.get(result,u\"items\")!=e.get(source,u\"items\"))+\":\"+yes(e.classes.resolve(std::get<opts::ObjectRef>(e.get(e.get(result,u\"items\"),u\"mi\").data))==nativeClass);",
      "expected": "true:true"
    },
    {
      "label": "same-node-graph-observed-through-alias",
      "cpp": "auto node=e.nodes.instance(e.node,e.klass,e.factory);auto source=e.object({{u\"node\",node}});auto result=opts::copy(e.context,source);auto bound=std::get<opts::ObjectRef>(e.get(result,u\"node\").data);e.nodes.resolve(bound)->setProperty(\"probe\",9);return property_host::debugText(property_host::string(e.node->getProperty(\"probe\")));",
      "expected": "9"
    },
    {
      "label": "ordinary-node-list-array-and-inherited-key",
      "cpp": "auto node=e.nodes.instance(e.node,e.klass,e.factory);auto dictionary=e.object({{u\"mi\",e.array({node,node})}});auto list=e.get(dictionary,u\"mi\");return yes(e.get(dictionary,u\"constructor\")==opts::Value(e.context.intrinsics().objectConstructor))+\":\"+yes(e.get(list,u\"0\")==e.get(list,u\"1\"));",
      "expected": "true:true"
    },
    {
      "label": "dictionary-enumeration-order",
      "cpp": "auto node=e.nodes.instance(e.node,e.klass,e.factory);auto dictionary=e.object({{u\"z\",node},{u\"2\",node},{u\"a\",node},{u\"1\",node}});std::string out;for(auto k:e.context.enumerableStringKeys(dictionary)){if(!out.empty())out+=\",\";out+=property_host::debugText(k);}return out;",
      "expected": "1,2,z,a"
    },
    {
      "label": "node-list-array-rebinding-retains-captured-array",
      "cpp": "auto node=e.nodes.instance(e.node,e.klass,e.factory);auto dictionary=e.object({{u\"mi\",e.array({node})}});auto old=e.get(dictionary,u\"mi\");e.context.set(dictionary,opts::Key(u\"mi\"),e.array({}));return yes(old!=e.get(dictionary,u\"mi\"))+\":\"+yes(e.nodes.resolve(std::get<opts::ObjectRef>(e.get(old,u\"0\").data))==e.node);",
