      "label": "map-delete-pt-no-fallback",
      "cpp": "u.UNIT_CASES->erase(u\"pt\");return val(u.UNIT_CASES->get(\"bad\"))+\":\"+val(Property(u.dimen2em(\"bad\")));",
      "expected": "ok|U:NaN"
    },
    {
      "label": "map-reinsert-key-at-end",
      "cpp": "u.UNIT_CASES->erase(u\"em\");u.UNIT_CASES->set(u\"em\",4);return property_host::debugText(u.UNIT_CASES->unit);",
      "expected": "ok|(ex|pt|pc|px|in|cm|mm|mu|em)"
    },
    {
      "label": "map-constructor-duplicate-key",
      "cpp": "UnitMap map(UnitEntries{{u\"x\",1},{u\"pt\",.1},{u\"x\",2}});return property_host::debugText(map.unit)+\":\"+val(map.get(\"x\"));",
      "expected": "ok|(x|pt):2"
    },
    {
      "label": "map-empty-constructor",
      "cpp": "u.UNIT_CASES=std::make_shared<UnitMap>(UnitEntries{});return property_host::debugText(u.UNIT_CASES->unit)+\":\"+shape(u.matchDimen(\"2\"))+\":\"+val(Property(u.dimen2em(\"2\")));",
      "expected": "ok|():2::1:NaN"
    },
    {
      "label": "map-alternative-prefix-order",
      "cpp": "u.UNIT_CASES=std::make_shared<UnitMap>(UnitEntries{{u\"e\",1},{u\"em\",2},{u\"pt\",.1}});return shape(u.matchDimen(\"2emtail\",true))+\":\"+shape(u.matchDimen(\"2em\"));",
      "expected": "ok|2:e:2:2:em:3"
    },
    {
      "label": "map-unicode-literal-key",
      "cpp": "u.UNIT_CASES->set(property_host::text(\"😀\"),2);return shape(u.matchDimen(\"2😀tail\",true));",
      "expected": "ok|2:😀:3"
    },
    {
      "label": "live-mu-factor",
      "cpp": "u.UNIT_CASES->set(u\"mu\",.25);return shape(u.matchDimen(\"2mu\"))+\":\"+val(Property(u.dimen2em(\"2mu\")));",
      "expected": "ok|0.5:em:3:0.5"
    }
  ]
