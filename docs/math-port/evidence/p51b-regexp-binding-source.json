    {
      "label": "option-copy-retains-actual-regexp",
      "cpp": "auto r=e.make();auto original=e.object({{u\"r\",r}});auto copied=opts::copy(e.context,original);return yes(copied!=opts::Value(original))+\":\"+yes(e.context.get(copied,opts::Key(u\"r\"))==opts::Value(r));",
      "expected": "true:true"
    },
    {
      "label": "copied-end-tuple-keeps-pattern-identity",
      "cpp": "auto r=e.make();auto tuple=e.tuple(r);auto copied=opts::copy(e.context,tuple);return yes(copied!=opts::Value(tuple))+\":\"+yes(e.context.get(copied,opts::Key(u\"2\"))==opts::Value(r));",
      "expected": "true:true"
    },
    {
      "label": "cursor-update-observed-through-copied-alias",
      "cpp": "auto r=e.make();auto copied=opts::copy(e.context,e.object({{u\"r\",r}}));auto alias=e.context.get(copied,opts::Key(u\"r\"));e.bindings.setLastIndex(r,1);auto match=e.bindings.exec(alias,u\"xxx\");return std::to_string(match->index)+\":\"+e.number(e.bindings.lastIndex(r))+\":\"+e.number(e.bindings.lastIndex(alias));",
      "expected": "1:2:2"
    },
    {
      "label": "independent-pattern-cursors",
      "cpp": "auto a=e.make(),b=e.make();e.bindings.setLastIndex(a,1);auto ma=e.bindings.exec(a,u\"xxx\"),mb=e.bindings.exec(b,u\"xxx\");return std::to_string(ma->index)+\":\"+std::to_string(mb->index)+\":\"+e.number(e.bindings.lastIndex(a))+\":\"+e.number(e.bindings.lastIndex(b));",
      "expected": "1:0:2:1"
    },
    {
      "label": "global-failure-resets-shared-cursor",
