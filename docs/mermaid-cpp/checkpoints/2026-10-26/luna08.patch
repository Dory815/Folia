+struct ErConfig { double node_spacing{140},rank_spacing{80},diagram_padding{10},entity_padding{6},min_entity_width{140},title_top_margin{25};bool use_max_width{true}; };
+struct ErTheme { std::string font_family{"Arial"},background{"#ECECFF"},border{"#9370DB"},text{"#333"},line{"#333"}; };
+struct ErRenderInput { ErDocument document;ErConfig config;ErTheme theme; };
+using ErMeasure=std::function<std::expected<std::pair<double,double>,std::string>(std::u16string_view,std::string_view)>;
+std::expected<ErDocument,std::string> parse_er(std::u16string_view);
+std::expected<void,std::string> append_er_svg(SvgDocument&,const ErRenderInput&,const ErMeasure&);
+}
