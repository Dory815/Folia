+struct ErEntity { std::u16string id,name,alias;std::vector<ErAttribute> attributes;std::vector<std::string> styles,compiled_styles;std::vector<std::u16string> classes{u"default"};std::size_t color_index{}; };
+struct ErRelationship { std::u16string source,role,target;ErCardinality source_card{},target_card{};ErRelationshipKind kind{};std::size_t index{}; };
+struct ErClass { std::u16string id;std::vector<std::string> styles,text_styles; };
+struct ErSubgraph { std::u16string id,title,direction;std::vector<std::u16string> nodes,classes;std::vector<std::string> styles;std::size_t parent{std::numeric_limits<std::size_t>::max()}; };
