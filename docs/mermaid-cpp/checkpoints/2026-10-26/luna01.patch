+GanttWeekday weekday(std::u16string_view value){if(value==u"monday")return GanttWeekday::monday;if(value==u"tuesday")return GanttWeekday::tuesday;if(value==u"wednesday")return GanttWeekday::wednesday;if(value==u"thursday")return GanttWeekday::thursday;if(value==u"friday")return GanttWeekday::friday;if(value==u"saturday")return GanttWeekday::saturday;if(value==u"sunday")return GanttWeekday::sunday;throw std::runtime_error("Invalid Gantt weekday");}
+class Parser {
+    std::u16string_view source_;GanttDocument out_;std::u16string section_;std::size_t automatic_id_{1},order_{};
