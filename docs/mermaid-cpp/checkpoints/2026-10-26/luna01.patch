new file mode 100644
--- /dev/null
+++ b/tests/mermaid_cpp/gantt.cpp
@@ -0,0 +1,25 @@
+#include "support/folia_test.hpp"
+import folia.mermaid.gantt;
+namespace {
+using namespace boost::ut;using namespace folia::mermaid;
+suite gantt=[] {
+    "mermaid_gantt_native_parser_owns_calendar_tasks_and_tags"_test=[] {
+        auto parsed=parse_gantt(u"gantt\ndateFormat YYYY-MM-DD\ninclusiveEndDates\ntopAxis\n"
+            u"weekday monday\nweekend friday\nincludes 2024-01-06,2024-01-07\n"
+            u"section Build\nCompile :active, crit, c1, 2024-01-01, 3d\nShip :milestone, 2024-01-04, 0d");
+        expect(fatal(parsed.has_value()));
+        expect(bool(parsed->date_format==u"YYYY-MM-DD"));expect(parsed->inclusive_end_dates);expect(parsed->top_axis);
+        expect(parsed->weekday==GanttWeekday::monday);expect(parsed->weekend==GanttWeekday::friday);
+        expect(parsed->includes.size()==std::size_t{2});expect(bool(parsed->includes[0]==u"2024-01-06"));
+        expect(parsed->tasks.size()==std::size_t{2});
+        expect(bool(parsed->tasks[0].id==u"c1"));expect(bool(parsed->tasks[0].section==u"Build"));
+        expect(parsed->tasks[0].active&&parsed->tasks[0].critical);expect(bool(parsed->tasks[0].start_data==u"2024-01-01"));
+        expect(parsed->tasks[1].milestone);expect(bool(parsed->tasks[1].id==u"task1"));
+    };
+    "mermaid_gantt_svg_requires_original_calendar_axis_and_styles"_test=[] {
+        auto parsed=parse_gantt(u"gantt\nsection S\nTask : 2024-01-01, 1d");expect(fatal(parsed.has_value()));
+        SvgDocument svg{"gantt-test"};auto rendered=append_gantt_svg(svg,{*parsed,{},{}},{});
+        expect(!rendered);expect(svg.elements=="<g></g>");
+    };
+};
+}
