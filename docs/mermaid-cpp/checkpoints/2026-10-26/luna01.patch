+// Mermaid 12.2.0 gantt/parser/gantt.jison and ganttDb.js.
+export module folia.mermaid.gantt;
+export import folia.mermaid.svg_document;
+import std;
+export namespace folia::mermaid {
+enum class GanttWeekday { monday,tuesday,wednesday,thursday,friday,saturday,sunday };
+struct GanttTask {
+    std::size_t order{};
+    std::u16string id, section, task, raw_data;
+    std::vector<std::u16string> classes;
+    std::u16string start_data, end_data;
+    std::int64_t start_milliseconds{},end_milliseconds{};
+    bool active{},done{},critical{},milestone{},vertical{};
+};
+struct GanttDocument {
+    std::u16string title,acc_title,acc_description,date_format,axis_format,tick_interval,today_marker;
+    std::vector<std::u16string> sections,includes,excludes;
+    std::vector<GanttTask> tasks;
+    GanttWeekday weekday{GanttWeekday::sunday};
+    GanttWeekday weekend{GanttWeekday::saturday};
+    bool inclusive_end_dates{},top_axis{};
+};
+struct GanttConfig {
+    double width=1200,bar_height=20,bar_gap=4,top_padding=50,left_padding=75,right_padding=75,
+        title_top_margin=25,font_size=16,grid_line_start_padding=35;
+    std::size_t number_section_styles=4;
+    bool use_max_width=true,compact=false;
+};
+struct GanttTheme {
+    std::u16string font_family;
+    std::string text="#333",grid="#ccc",today="#f66",section0="#f4f4f4",section2="#eee",
+        alt_section="#fafafa",task="#8a9",active="#fc6",done="#ccc",critical="#f66",
+        milestone="#9cf",outside_text="#333";
+};
+struct GanttRenderInput { GanttDocument document;GanttConfig config;GanttTheme theme; };
+struct GanttTextBox {double width{},height{};};
+using GanttMeasure=std::function<std::expected<GanttTextBox,std::string>(std::u16string_view,double,unsigned,bool)>;
+std::expected<GanttDocument,std::string> parse_gantt(std::u16string_view);
+std::expected<void,std::string> append_gantt_svg(SvgDocument&,const GanttRenderInput&,const GanttMeasure&);
+}
