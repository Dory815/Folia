+// Native implementation of Mermaid 12.2.0 gantt/parser/gantt.jison and DB.
+module folia.mermaid.gantt;
+import std;
+namespace folia::mermaid {
+namespace {
+bool ws(char16_t c){return c==u' '||c==u'\t'||c==u'\r'||c==u'\n'||c==u'\v'||c==u'\f';}
+char16_t lower(char16_t c){return c>=u'A'&&c<=u'Z'?c+(u'a'-u'A'):c;}
