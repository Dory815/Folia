+ s=trim(s);if(s.empty()||s.front()!=open)return {};s.remove_prefix(1);std::u16string r;bool escape=false;for(std::size_t i=0;i<s.size();++i){auto c=s[i];if(escape){r+=c;escape=false;continue;}if(c==u'\\'){escape=true;r+=c;continue;}if(c==close){s.remove_prefix(i+1);auto t=trim(r);if(t.size()>=2&&((t.front()==u'\''&&t.back()==u'\'')||(t.front()==u'"'&&t.back()==u'"'))){t.remove_prefix(1);t.remove_suffix(1);}std::u16string out(t);for(std::size_t p=0;(p=out.find(u"\\\"",p))!=out.npos;)out.replace(p,2,u"\"");for(std::size_t p=0;(p=out.find(u"\\'",p))!=out.npos;)out.replace(p,2,u"'");return out; }r+=c;}return {};}
