+// Mermaid 12.2.0 Architecture grammar/database and native layout input.
+export module folia.mermaid.architecture;
+export import folia.mermaid.svg_document;
+import std;
+export namespace folia::mermaid {
+enum class ArchitectureDirection : char { left='L',right='R',top='T',bottom='B' };
+enum class ArchitectureAlignment : std::uint8_t { horizontal,vertical,bend };
+enum class ArchitectureAlignmentHint : std::uint8_t { row,column };
+struct ArchitectureNode { std::u16string id,parent,icon,icon_text,title;bool junction{};std::vector<std::size_t> edges; };
+struct ArchitectureGroup { std::u16string id,parent,icon,title; };
+struct ArchitectureEdge { std::size_t lhs{},rhs{};ArchitectureDirection lhs_dir{},rhs_dir{};bool lhs_into{},rhs_into{},lhs_group{},rhs_group{};std::u16string title; };
+struct ArchitectureHint { ArchitectureAlignmentHint direction{};std::vector<std::size_t> members; };
+struct ArchitectureDocument { std::vector<ArchitectureNode> nodes;std::vector<ArchitectureGroup> groups;std::vector<ArchitectureEdge> edges;std::vector<ArchitectureHint> hints;std::u16string title,acc_title,acc_description; };
+struct ArchitecturePosition { double x{},y{}; };
+using ArchitectureDirectionPair=std::pair<ArchitectureDirection,ArchitectureDirection>;
+struct ArchitectureDataStructures { std::vector<std::vector<std::pair<ArchitectureDirectionPair,std::size_t>>> adjacency;std::vector<std::vector<std::pair<std::size_t,ArchitecturePosition>>> spatial_maps;std::map<std::pair<std::size_t,std::size_t>,ArchitectureAlignment> group_alignments; };
+std::expected<ArchitectureDocument,std::string> parse_architecture(std::u16string_view);
+std::expected<ArchitectureDataStructures,std::string> architecture_data_structures(const ArchitectureDocument&);
+std::expected<void,std::string> append_architecture_svg(SvgDocument&,const ArchitectureDocument&);
+}
