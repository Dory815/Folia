+/// Add all code points equivalent under ECMAScript legacy Canonicalize.
+/// The source set is retained, then its canonical image and all table-driven
+/// preimages are added. Non-BMP values and identity BMP units stay unchanged.
+pub(crate) fn add_legacy_icase_code_points(mut input: CodePointSet) -> CodePointSet {
+    let mut canonical_image = input.clone();
+    for &(from, to) in crate::legacy_case::MAPPINGS {
+        if input.contains(from) {
+            canonical_image.add_one(to);
+        }
+    }
+    input.add_set(canonical_image.clone());
+    for &(from, to) in crate::legacy_case::MAPPINGS {
+        if canonical_image.contains(to) {
+            input.add_one(from);
+        }
+    }
+    input
+}
