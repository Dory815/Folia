{
  "schema": 1,
  "purpose": "Original-only full enabled-profile probes; feature labels are intended coverage, not proof of handler invocation.",
  "cases": [
    {"name":"action-toggle","tex":"\\toggle{x}{y}\\endtoggle","features":["action"]},
    {"name":"action-tooltip","tex":"\\mathtip{x+1}{y^2}","features":["action"]},
    {"name":"ams-align-tag","tex":"\\begin{align}x&=1\\tag{A}\\\\y&=2\\end{align}","display":true,"features":["ams","tagformat"]},
    {"name":"amscd-diagram","tex":"\\begin{CD}A @>f>> B\\\\@VgVV @VVhV\\\\C @>>k> D\\end{CD}","display":true,"features":["amscd"]},
    {"name":"bbm-family","tex":"\\mathbbm{R}+\\mathbbmss{N}+\\mathbbmtt{1}","features":["bbm"]},
    {"name":"bboldx-family","tex":"\\mathbb{ABCabc012}+\\imathbb+\\jmathbb","features":["bboldx"]},
    {"name":"bbox-rounded-border","tex":"\\bbox[4px,#ffffaa,border:2px solid red]{\\frac{x}{y}}","features":["bbox"]},
    {"name":"begingroup-local-def","tex":"\\begingroup\\def\\local{x}\\local\\endgroup+y","features":["begingroup","newcommand"]},
    {"name":"boldsymbol-symbols","tex":"\\boldsymbol{\\alpha+\\nabla}+\\boldsymbol{\\text{word}}","features":["boldsymbol","textmacros"]},
    {"name":"braket-delimiters","tex":"\\Braket{\\psi|A|\\phi}+\\Set{x|x>0}","features":["braket"]},
    {"name":"bussproofs-tree","tex":"\\begin{prooftree}\\AxiomC{$P$}\\AxiomC{$P\\to Q$}\\BinaryInfC{$Q$}\\end{prooftree}","display":true,"features":["bussproofs"]},
    {"name":"cancel-lines","tex":"\\cancel{x}+\\bcancel{y}+\\xcancel{z}+\\cancelto{0}{a}","features":["cancel"]},
    {"name":"cases-numbered","tex":"\\begin{numcases}{f(x)=}x&$x>0$\\\\0&$x\\le0$\\end{numcases}","display":true,"features":["cases"]},
    {"name":"centernot-operator","tex":"A\\centernot\\implies B","features":["centernot"]},
    {"name":"color-background","tex":"\\colorbox{yellow}{$x$}+\\fcolorbox{red}{blue}{$y$}","features":["color"]},
    {"name":"colortbl-row-cell","tex":"\\begin{array}{cc}\\rowcolor{yellow}a&b\\\\c&\\cellcolor{red}d\\end{array}","display":true,"features":["colortbl"]},
    {"name":"configmacros-user-definition","tex":"\\newcommand{\\probe}[2][a]{#1+#2}\\probe{b}","features":["configmacros","newcommand"]},
    {"name":"dsfont-family","tex":"\\mathds{RN1}+\\boldsymbol{\\mathds{R}}","features":["dsfont","boldsymbol"]},
    {"name":"empheq-aligned-box","tex":"\\begin{empheq}[box=\\fbox]{align}x&=1\\\\y&=2\\end{empheq}","display":true,"features":["empheq"]},
    {"name":"empheq-left-brace","tex":"\\begin{empheq}[left=\\empheqlbrace]{align}x&=1\\\\y&=2\\end{empheq}","display":true,"features":["empheq"]},
    {"name":"enclose-notations","tex":"\\enclose{box circle updiagonalstrike}{x+y}","features":["enclose"]},
    {"name":"extpfeil-arrows","tex":"\\xtwoheadrightarrow[a]{b}+\\xmapsto{f}","features":["extpfeil"]},
    {"name":"fontsize-switches","tex":"{\\tiny x}+{\\Huge y}","features":["fontsizev3"]},
    {"name":"gensymb-units","tex":"20\\degree+3\\ohm+4\\micro","features":["gensymb"]},
    {"name":"html-attributes-link","tex":"\\href{https://example.test/a?b=1&c=2}{\\class{probe}{\\cssId{id}{x}}}","features":["html"]},
    {"name":"mathtools-prescripts","tex":"\\prescript{a}{b}{X}_c^d+\\underbracket{x+y}","features":["mathtools"]},
    {"name":"mhchem-equation","tex":"\\ce{2H2 + O2 -> 2H2O}","features":["mhchem"]},
    {"name":"newcommand-delimited","tex":"\\def\\probe#1,#2;{#2/#1}\\probe a,b;","features":["newcommand"]},
    {"name":"noundefined-control-sequence","tex":"\\notARealMathJaxCommand+x","features":["noundefined"]},
    {"name":"physics-derivatives-bra","tex":"\\dv[2]{f}{x}+\\bra{a}\\ket{b}+\\qty(\\frac{1}{x})","features":["physics"]},
    {"name":"setoptions-units","tex":"\\setOptions[units]{loose: true}\\units[2]{m}","features":["setoptions","units"]},
    {"name":"setoptions-units-valid","tex":"\\setOptions[units]{loose=true}\\units[2]{m}","features":["setoptions","units"]},
    {"name":"tagformat-explicit","tex":"\\begin{equation}x=1\\tag{probe}\\end{equation}","display":true,"features":["tagformat","ams"]},
    {"name":"texhtml-default-disabled","tex":"<tex-html><b>hello</b></tex-html>","features":["texhtml"]},
    {"name":"texhtml-explicitly-enabled","tex":"\\setOptions{allowTexHTML=true}<tex-html><b data-probe=\"x\">hello &amp; world</b></tex-html>\\setOptions{allowTexHTML=false}","features":["texhtml","setoptions"]},
    {"name":"textcomp-symbols","tex":"\\text{\\textdegree \\textcopyright \\textregistered}","features":["textcomp","textmacros"]},
    {"name":"textmacros-style","tex":"\\text{one \\textbf{bold} \\textit{italic} \\emph{em}}","features":["textmacros"]},
    {"name":"unicode-astral","tex":"\\unicode{x1F600}+\\unicode{x4E2D}","features":["unicode"]},
    {"name":"units-bevelled","tex":"\\unitfrac[2]{m}{s}+\\nicefrac{a}{b}","features":["units"]},
    {"name":"upgreek-symbols","tex":"\\upalpha+\\upbeta+\\upGamma","features":["upgreek"]},
    {"name":"verb-literal","tex":"\\verb|a_b%&{}|","features":["verb"]},
    {"name":"base-primes-decimals","tex":"f''(x)=12.34+\\infty","features":["base"]},
    {"name":"base-spaces-rules","tex":"a\\hspace{1em}b+\\rule{1em}{.2em}","features":["base"]},
    {"name":"base-smash-raise","tex":"\\smash{\\frac{a}{b}}+\\raise1em\\hbox{up}","features":["base","textmacros"]},
    {"name":"base-phantom-sides","tex":"a\\hphantom{xx}+\\vphantom{\\frac{a}{b}}+\\mathstrut x","features":["base"]},
    {"name":"base-accent-stretch","tex":"\\overbrace{a+b}^{n}+\\underbrace{x+y}_{m}+\\widetilde{abc}","features":["base"]},
    {"name":"base-operators-inline","tex":"\\sum_i^n+\\int_0^1 f(x)\\,dx","features":["base"]},
    {"name":"base-operators-display","tex":"\\sum_i^n+\\int_0^1 f(x)\\,dx","display":true,"features":["base"]},
    {"name":"base-scriptstyles","tex":"x^{y^{z^w}}+{\\scriptscriptstyle\\frac{a}{b}}","features":["base"]},
    {"name":"base-infix-bevel","tex":"{a\\over b}+{c\\atop d}+{e\\above1pt f}","features":["base"]},
    {"name":"base-negative-space","tex":"a\\!b+\\kern-0.5em c","features":["base"]},
    {"name":"unknown-text-families","tex":"\\text{漢字😀 é}+\\mathsf{ABC}+\\mathtt{123}","features":["base","textmacros"]},
    {"name":"inline-linebreak-narrow","tex":"a+b+c+d+e+f+g+h+i+j+k","width":80,"features":["base"]},
    {"name":"display-linebreak-table","tex":"\\begin{aligned}a&=b+c+d+e+f+g+h\\\\x&=y+z\\end{aligned}","display":true,"width":120,"features":["ams"]},
    {"name":"malformed-unclosed-fraction","tex":"\\frac{a}{","features":["base"]},
    {"name":"malformed-mismatched-environment","tex":"\\begin{matrix}a&b\\end{aligned}","display":true,"features":["base","ams"]},
    {"name":"malformed-missing-right","tex":"\\left(x","features":["base"]}
  ]
}
