diff --git a/src/app-winui/editor/rendering/EmbeddedCompletionDispatch.h b/src/app-winui/editor/rendering/EmbeddedCompletionDispatch.h
new file mode 100644
index 0000000..822c60e
--- /dev/null
+++ b/src/app-winui/editor/rendering/EmbeddedCompletionDispatch.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+namespace winrt::Folia::detail
+{
+    template<class State, class Enqueue>
+    void QueueMathCompletion(std::weak_ptr<State> weakState, Enqueue&& enqueue)
+    {
+        auto state = weakState.lock();
+        if (!state || state->embeddedCompletionPending.exchange(true)) return;
+
+        auto accepted = std::forward<Enqueue>(enqueue)([weakState]
+        {
+            auto state = weakState.lock();
+            if (!state) return;
+
+            state->embeddedCompletionPending = false;
+            std::function<void()> callback;
+            {
+                std::scoped_lock lock(state->mutex);
+                if (state->active)
+                {
+                    ++state->embeddedGeneration;
+                    callback = state->callback;
+                }
+            }
+            if (callback) callback();
+        });
+        if (!accepted)
+        {
+            if (auto state = weakState.lock()) state->embeddedCompletionPending = false;
+        }
+    }
+}
