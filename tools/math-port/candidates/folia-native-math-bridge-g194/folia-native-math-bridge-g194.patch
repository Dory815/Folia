diff --git a/build_app.ps1 b/build_app.ps1
index 74961de..bcec3d7 100644
--- a/build_app.ps1
+++ b/build_app.ps1
@@ -28,7 +28,7 @@ if (-not (Test-Path -LiteralPath $VsWhere -PathType Leaf)) {
     throw "Visual Studio locator was not found: $VsWhere"
 }
 
-$Installation = & $VsWhere -latest -products * -requires Microsoft.Component.MSBuild -property installationPath
+$Installation = & $VsWhere -latest -products * -requires Microsoft.Component.MSBuild -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath | Select-Object -First 1
 if ($LASTEXITCODE -ne 0 -or -not $Installation) {
     throw 'A Visual Studio installation with MSBuild was not found.'
 }
@@ -38,6 +38,54 @@ if (-not (Test-Path -LiteralPath $MSBuild -PathType Leaf)) {
     throw "MSBuild was not found: $MSBuild"
 }
 
+$VcVars = Join-Path $Installation 'VC\Auxiliary\Build\vcvars64.bat'
+if (-not (Test-Path -LiteralPath $VcVars -PathType Leaf)) {
+    throw "Visual Studio x64 toolchain setup was not found: $VcVars"
+}
+$VcEnvironment = & $env:ComSpec /d /c "call `"$VcVars`" >nul && set"
+if ($LASTEXITCODE -ne 0) { throw "Visual Studio x64 toolchain setup failed with exit code $LASTEXITCODE" }
+foreach ($Variable in $VcEnvironment) {
+    $Separator = $Variable.IndexOf('=')
+    if ($Separator -gt 0) {
+        $VariableName = $Variable.Substring(0, $Separator)
+        Set-Item -Path "Env:$VariableName" -Value $Variable.Substring($Separator + 1)
+    }
+}
+
+$MathRuntime = if ($SelfContained) {
+    if ($Configuration -eq 'Debug') { 'MultiThreadedDebug' } else { 'MultiThreaded' }
+} else {
+    if ($Configuration -eq 'Debug') { 'MultiThreadedDebugDLL' } else { 'MultiThreadedDLL' }
+}
+$MathBuild = Join-Path $Root 'build\core'
+$MathCache = Join-Path $MathBuild 'CMakeCache.txt'
+$NeedsConfigure = -not (Test-Path -LiteralPath $MathCache -PathType Leaf)
+if (-not $NeedsConfigure) {
+    $CacheText = Get-Content -LiteralPath $MathCache -Raw
+    $NeedsConfigure = $CacheText -notmatch 'CMAKE_GENERATOR:INTERNAL=Ninja' -or
+        $CacheText -notmatch "CMAKE_BUILD_TYPE:STRING=$Configuration" -or
+        $CacheText -notmatch "CMAKE_MSVC_RUNTIME_LIBRARY:STRING=$MathRuntime"
+}
+if ($NeedsConfigure) {
+    & cmake -S $Root -B $MathBuild -G Ninja -DCMAKE_BUILD_TYPE=$Configuration -DCMAKE_MSVC_RUNTIME_LIBRARY=$MathRuntime
+    if ($LASTEXITCODE -ne 0) { throw "folia_math CMake configure failed with exit code $LASTEXITCODE" }
+}
+$CacheText = Get-Content -LiteralPath $MathCache -Raw
+if ($CacheText -notmatch 'CMAKE_GENERATOR:INTERNAL=Ninja' -or $CacheText -notmatch "CMAKE_BUILD_TYPE:STRING=$Configuration" -or $CacheText -notmatch "CMAKE_MSVC_RUNTIME_LIBRARY:STRING=$MathRuntime") {
+    throw "CMake math build tree does not match $Configuration/$MathRuntime/Ninja: $MathBuild"
+}
+$CompilerCacheLine = Get-Content -LiteralPath $MathCache | Where-Object { $_ -like 'CMAKE_CXX_COMPILER:FILEPATH=*' } | Select-Object -First 1
+if (-not $CompilerCacheLine) {
+    throw "CMAKE_CXX_COMPILER is missing from the math CMake cache: $MathCache"
+}
+$CachedCompiler = $CompilerCacheLine.Substring('CMAKE_CXX_COMPILER:FILEPATH='.Length).Replace('/', '\')
+$ExpectedCompiler = Join-Path $env:VCToolsInstallDir 'bin\Hostx64\x64\cl.exe'
+if ([IO.Path]::GetFullPath($CachedCompiler) -ine [IO.Path]::GetFullPath($ExpectedCompiler)) {
+    throw "The existing folia_math IFCs use a different cl.exe. Reconfigure build/core with $ExpectedCompiler before building the app."
+}
+& cmake --build $MathBuild --target folia_math --config $Configuration
+if ($LASTEXITCODE -ne 0) { throw "folia_math build failed with exit code $LASTEXITCODE" }
+
 $Properties = @(
     "/p:Configuration=$Configuration",
     "/p:Platform=$Platform"
