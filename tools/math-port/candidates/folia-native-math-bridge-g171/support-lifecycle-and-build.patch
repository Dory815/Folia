diff --git a/build_app.ps1 b/build_app.ps1
--- a/build_app.ps1
+++ b/build_app.ps1
@@ -24,6 +24,29 @@
 if (-not (Test-Path -LiteralPath $Project -PathType Leaf)) {
     throw "Missing WinUI project: $Project"
 }
+$MathBuildName = if ($SelfContained) {
+    if ($Configuration -eq 'Release') { 'core-mt-release' } else { 'core-mt' }
+} else {
+    if ($Configuration -eq 'Release') { 'core-release' } else { 'core' }
+}
+$MathRuntime = if ($SelfContained) {
+    if ($Configuration -eq 'Debug') { 'MultiThreadedDebug' } else { 'MultiThreaded' }
+} else {
+    if ($Configuration -eq 'Debug') { 'MultiThreadedDebugDLL' } else { 'MultiThreadedDLL' }
+}
+$MathBuild = Join-Path $Root (Join-Path 'build' $MathBuildName)
+$MathCache = Join-Path $MathBuild 'CMakeCache.txt'
+if (-not (Test-Path -LiteralPath $MathCache -PathType Leaf)) {
+    & cmake -S $Root -B $MathBuild -G Ninja -DCMAKE_BUILD_TYPE=$Configuration -DCMAKE_MSVC_RUNTIME_LIBRARY=$MathRuntime
+    if ($LASTEXITCODE -ne 0) { throw "folia_math CMake configure failed with exit code $LASTEXITCODE" }
+}
+$CacheText = Get-Content -LiteralPath $MathCache -Raw
+if ($CacheText -notmatch 'CMAKE_GENERATOR:INTERNAL=Ninja' -or $CacheText -notmatch "CMAKE_BUILD_TYPE:STRING=$Configuration" -or $CacheText -notmatch "CMAKE_MSVC_RUNTIME_LIBRARY:STRING=$MathRuntime") {
+    throw "CMake math build tree does not match $Configuration/$MathRuntime/Ninja: $MathBuild"
+}
+& cmake --build $MathBuild --target folia_math --config $Configuration
+if ($LASTEXITCODE -ne 0) { throw "folia_math build failed with exit code $LASTEXITCODE" }
+
 if (-not (Test-Path -LiteralPath $VsWhere -PathType Leaf)) {
     throw "Visual Studio locator was not found: $VsWhere"
 }
