diff --git a/tests/math/promise_context_bindings_owner.cpp b/tests/math/promise_context_bindings_owner.cpp
new file mode 100644
index 0000000..ca148d9
--- /dev/null
+++ b/tests/math/promise_context_bindings_owner.cpp
@@ -0,0 +1,162 @@
+#include "support/folia_test.hpp"
+import folia.math.util.promise_context_bindings;
+
+#include <any>
+#include <array>
+#include <atomic>
+#include <exception>
+#include <memory>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace {
+using namespace boost::ut;
+using namespace folia::math;
+namespace o = folia::math::options;
+namespace a = folia::math::async;
+
+o::Value encode(const a::Value& input)
+{
+    if (const auto* value = std::any_cast<o::Value>(&input)) return *value;
+    if (const auto* thrown = std::any_cast<a::ThrownValue>(&input))
+        if (const auto* value = std::any_cast<o::Value>(&thrown->value)) return *value;
+    return o::Value(o::Undefined{});
+}
+
+a::Value decode(o::Value value)
+{
+    return a::Value(std::move(value));
+}
+
+struct PromiseOwner
+{
+    o::Context context;
+    OptionFunctionBindings provider{context};
+    std::shared_ptr<std::atomic_bool> lease = std::make_shared<std::atomic_bool>(true);
+    a::QueueRef queue = std::make_shared<a::JobQueue>();
+    std::shared_ptr<PromiseContextBindings> bindings;
+
+    PromiseOwner()
+    {
+        bindings = std::make_shared<PromiseContextBindings>(context, queue, lease, encode, decode);
+        bindings->initialize();
+    }
+};
+
+a::PromiseRef payloadPromise(o::Context& context, o::Value const& wrapper)
+{
+    const auto* object = std::get_if<o::ObjectRef>(&wrapper.data);
+    if (!object) return {};
+    const auto* promise = std::any_cast<a::PromiseRef>(&context.payload(*object));
+    return promise ? *promise : a::PromiseRef{};
+}
+
+suite promise_context_owner = [] {
+    "pending real promise reaction does not retain its queue or context bindings"_test = [] {
+        std::weak_ptr<a::JobQueue> weakQueue;
+        std::weak_ptr<PromiseContextBindings> weakBindings;
+        a::PromiseRef pending;
+        a::PromiseRef chained;
+        {
+            auto owner = std::make_shared<PromiseOwner>();
+            weakQueue = owner->queue;
+            weakBindings = owner->bindings;
+            pending = a::Promise::create(owner->queue);
+            const o::Value wrapped(owner->bindings->wrap(pending));
+            const auto callback = owner->context.function(u"pending", [](o::Context&, o::Value, std::span<const o::Value>) {
+                return o::Value(u"finished");
+            });
+            const auto then = owner->context.get(wrapped, o::Key(u"then"));
+            const auto result = owner->context.callMember(then, wrapped, std::array<o::Value, 1>{o::Value(callback)});
+            chained = payloadPromise(owner->context, result);
+            expect(chained && chained->state() == a::State::pending)
+                << "the actual context projection has installed a pending native reaction";
+            owner.reset();
+        }
+        expect(weakQueue.expired()) << "JobQueue -> PromiseState -> pending reaction does not keep the queue alive";
+        expect(weakBindings.expired()) << "pending reaction keeps only a weak PromiseContextBindings owner";
+        expect(pending && chained) << "native promise handles themselves do not own their queue";
+    };
+
+    "live canonical queue preserves rejection then catch chaining"_test = [] {
+        PromiseOwner owner;
+        auto input = a::Promise::create(owner.queue);
+        const o::Value wrapped(owner.bindings->wrap(input));
+        const auto wrapperAgain = owner.bindings->wrap(input);
+        expect(wrapperAgain == std::get<o::ObjectRef>(wrapped.data)) << "one native promise has one canonical context wrapper";
+
+        std::vector<o::Value> rejected;
+        std::vector<o::Value> caught;
+        const auto fulfilled = owner.context.function(u"fulfilled", [](o::Context&, o::Value, std::span<const o::Value>) {
+            return o::Value(u"unexpected fulfillment");
+        });
+        const auto rejectedCallback = owner.context.function(u"rejected", [&](o::Context&, o::Value, std::span<const o::Value> args) {
+            rejected.assign(args.begin(), args.end());
+            return o::Value(u"recovered");
+        });
+        const auto then = owner.context.get(wrapped, o::Key(u"then"));
+        const auto chainedWrapper = owner.context.callMember(
+            then, wrapped, std::array<o::Value, 2>{o::Value(fulfilled), o::Value(rejectedCallback)});
+        const auto chained = payloadPromise(owner.context, chainedWrapper);
+        expect(chained && chained->belongsTo(owner.queue)) << "then returns a promise in the original queue";
+
+        const auto catchMethod = owner.context.get(chainedWrapper, o::Key(u"catch"));
+        const auto catchCallback = owner.context.function(u"catch", [&](o::Context&, o::Value, std::span<const o::Value> args) {
+            caught.assign(args.begin(), args.end());
+            return o::Value(u"caught after recovery");
+        });
+        const auto outputWrapper = owner.context.callMember(
+            catchMethod, chainedWrapper, std::array<o::Value, 1>{o::Value(catchCallback)});
+        const auto output = payloadPromise(owner.context, outputWrapper);
+        expect(output && output != chained && output->belongsTo(owner.queue))
+            << "catch creates a distinct promise on the same canonical queue";
+
+        input->reject(a::ThrownValue{a::Value(o::Value(u"original rejection"))});
+        while (owner.queue->runOne()) {}
+        expect(rejected == std::vector<o::Value>{o::Value(u"original rejection")});
+        expect(caught == std::vector<o::Value>{o::Value(u"recovered")});
+        expect(output->state() == a::State::fulfilled);
+        expect(std::any_cast<o::Value>(output->value()) == o::Value(u"caught after recovery"));
+    };
+
+    "expired bindings reject late invocation and pending reactions explicitly"_test = [] {
+        auto owner = std::make_shared<PromiseOwner>();
+        auto queue = owner->queue;
+        auto input = a::Promise::create(queue);
+        const o::Value wrapped(owner->bindings->wrap(input));
+        const auto then = owner->context.get(wrapped, o::Key(u"then"));
+        const auto callback = owner->context.function(u"late", [](o::Context&, o::Value, std::span<const o::Value>) {
+            return o::Value(u"must not run");
+        });
+        const auto result = owner->context.callMember(then, wrapped, std::array<o::Value, 1>{o::Value(callback)});
+        const auto chained = payloadPromise(owner->context, result);
+        std::weak_ptr<PromiseContextBindings> weakBindings = owner->bindings;
+
+        owner->bindings.reset();
+        expect(weakBindings.expired()) << "context method callbacks do not retain the bindings provider";
+        bool directExpiredError = false;
+        try {
+            (void)owner->context.callMember(then, wrapped, std::array<o::Value, 1>{o::Value(callback)});
+        } catch (const o::Exception& error) {
+            directExpiredError = error.name == "TypeError" && error.message == u"Promise Context services have expired";
+        }
+        expect(directExpiredError) << "calling a saved then method after owner expiry returns the explicit service error";
+
+        input->resolve(a::Value(o::Value(u"late value")));
+        while (queue->runOne()) {}
+        expect(chained && chained->state() == a::State::rejected)
+            << "a queued reaction whose bindings expired rejects its canonical next promise";
+        const auto* failure = std::any_cast<std::exception_ptr>(&chained->value());
+        bool reactionExpiredError = false;
+        if (failure) {
+            try {
+                std::rethrow_exception(*failure);
+            } catch (const o::Exception& error) {
+                reactionExpiredError = error.name == "TypeError" && error.message == u"Promise Context services have expired";
+            }
+        }
+        expect(reactionExpiredError) << "late pending reaction propagates the explicit service-expired error";
+    };
+};
+}
diff --git a/tests/math/parser_runtime_promise_owner.cpp b/tests/math/parser_runtime_promise_owner.cpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/tests/math/parser_runtime_promise_owner.cpp
@@ -0,0 +1,137 @@
+#include "support/folia_test.hpp"
+import folia.math.input.tex.parser;
+import folia.math.util.option_functions;
+import folia.math.util.regexp_host;
+import folia.math.core.find_math_host;
+import folia.math.core.input_jax_host;
+import folia.math.input.tex.find_tex_host;
+
+#include <any>
+#include <array>
+#include <memory>
+#include <span>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+using namespace boost::ut;
+using namespace folia::math;
+namespace o = folia::math::options;
+namespace a = folia::math::async;
+namespace t = folia::math::tex;
+
+struct RuntimeOwner {
+    o::Context context;
+    OptionFunctionBindings functions{context};
+    regexp_host::RegExpBindings regexp{context};
+    Unicode16Normalization unicode;
+    core::InputJaxModule input{context};
+    core::FindMathModule findMath{context};
+    t::FindTeXModule findTeX{context, findMath, regexp};
+    std::unique_ptr<t::ParserRuntime> runtime;
+
+    RuntimeOwner() {
+        runtime = std::make_unique<t::ParserRuntime>(context, functions, regexp, unicode, input, findTeX);
+        runtime->initializeParserRuntime();
+    }
+};
+
+a::PromiseRef payloadPromise(o::Context& context, const o::Value& wrapper) {
+    const auto* object = std::get_if<o::ObjectRef>(&wrapper.data);
+    if (!object) return {};
+    const auto* promise = std::any_cast<a::PromiseRef>(&context.payload(*object));
+    return promise ? *promise : a::PromiseRef{};
+}
+
+suite parser_runtime_promise_owner = [] {
+    "ParserRuntime FunctionList async execution uses the runtime queue and expires with its Context"_test = [] {
+        std::weak_ptr<a::JobQueue> weakQueue;
+        a::PromiseRef inputPromise;
+        a::PromiseRef outputPromise;
+        a::PromiseRef chainedPromise;
+        o::ObjectRef listObject{};
+        o::ObjectRef savedAsyncExecute{};
+        o::ObjectRef savedThen{};
+        o::ObjectRef outputWrapperObject{};
+        {
+            auto owner = std::make_unique<RuntimeOwner>();
+            auto& context = owner->context;
+            auto& runtime = *owner->runtime;
+            const auto queue = runtime.queue();
+            weakQueue = queue;
+            inputPromise = a::Promise::create(queue);
+
+            // This Context object is the real OptionFunctionBindings result. Its
+            // payload is the native Promise returned by the callback, as in the
+            // FunctionListContextBindings async value conversion path.
+            const auto inputWrapper = context.object();
+            context.setPayload(inputWrapper, inputPromise);
+            auto native = std::make_shared<Function>();
+            native->call = [inputWrapper](const FunctionReceiver&, FunctionArgs) -> std::any {
+                return std::any(o::Value(inputWrapper));
+            };
+            OptionCallBinding binding{
+                [](o::Context&, o::Value receiver) { return FunctionReceiver(std::move(receiver)); },
+                [](o::Context&, std::span<const o::Value>) { return std::vector<std::any>{}; },
+                [inputWrapper](o::Context&, const std::any& result) -> o::Value {
+                    const auto* returned = std::any_cast<o::Value>(&result);
+                    const auto* returnedObject = returned ? std::get_if<o::ObjectRef>(&returned->data) : nullptr;
+                    if (!returnedObject || *returnedObject != inputWrapper)
+                        throw std::logic_error("async callback result lost its Context Promise object");
+                    return *returned;
+                }};
+            const auto callback = owner->functions.bind(native, std::move(binding), u"pending Promise callback");
+            const auto definitions = context.array();
+            context.set(definitions, o::Key(u"0"), o::Value(callback));
+            auto list = runtime.functionLists.make(o::Value(definitions));
+            listObject = runtime.functionLists.bind(list);
+            savedAsyncExecute = std::get<o::ObjectRef>(context.get(o::Value(listObject), o::Key(u"asyncExecute")).data);
+            const auto outputWrapper = context.callMember(savedAsyncExecute, o::Value(listObject), std::span<const o::Value>{});
+            outputWrapperObject = std::get<o::ObjectRef>(outputWrapper.data);
+            outputPromise = payloadPromise(context, outputWrapper);
+            expect(outputPromise && outputPromise->belongsTo(queue) && outputPromise->state() == a::State::pending)
+                << "the actual FunctionList asyncExecute returns a pending Promise owned by ParserRuntime.queue";
+
+            const auto continuation = context.function(u"continue", [](o::Context&, o::Value, std::span<const o::Value> args) {
+                return args.empty() ? o::Value(o::Undefined{}) : args.front();
+            });
+            savedThen = std::get<o::ObjectRef>(context.get(outputWrapper, o::Key(u"then")).data);
+            const auto chainedWrapper = context.callMember(savedThen, outputWrapper, std::array<o::Value, 1>{o::Value(continuation)});
+            chainedPromise = payloadPromise(context, chainedWrapper);
+            expect(chainedPromise && chainedPromise->belongsTo(queue) && chainedPromise->state() == a::State::pending)
+                << "then continues the real async execution on the same runtime queue";
+
+            expect(inputPromise->state() == a::State::pending && outputPromise->state() == a::State::pending &&
+                   chainedPromise->state() == a::State::pending)
+                << "the real async list and its Context then chain remain pending on the unresolved callback Promise";
+
+            // The still-live Context owns the installed FunctionList service
+            // closures. ParserRuntime shutdown invalidates them, but does not
+            // forcibly detach roots that the Context still owns.
+            owner->runtime.reset();
+            expect(!weakQueue.expired()) << "the live Context remains the intentional owner of installed FunctionList services";
+            bool asyncExpired = false;
+            try {
+                (void)context.callMember(savedAsyncExecute, o::Value(listObject), std::span<const o::Value>{});
+            } catch (const o::Exception& error) {
+                asyncExpired = error.name == "TypeError" && error.message == u"FunctionList runtime services have expired";
+            }
+            expect(asyncExpired) << "an old FunctionList method reports an explicit error after ParserRuntime shutdown";
+            bool promiseExpired = false;
+            try {
+                (void)context.callMember(savedThen, o::Value(outputWrapperObject), std::span<const o::Value>{});
+            } catch (const o::Exception& error) {
+                promiseExpired = error.name == "TypeError" && error.message == u"Promise Context services have expired";
+            }
+            expect(promiseExpired) << "an old Promise method reports an explicit error after ParserRuntime shutdown";
+            owner.reset();
+        }
+        expect(weakQueue.expired()) << "after Context and ParserRuntime owners leave scope, pending native handles do not retain the queue";
+        expect(inputPromise && outputPromise && chainedPromise)
+            << "external PromiseRef handles are non-owning with respect to the queue";
+    };
+};
+} // namespace
+
+
+
