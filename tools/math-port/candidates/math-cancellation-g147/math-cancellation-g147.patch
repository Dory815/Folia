+module folia.math.cancellation;
+import std;
+
+namespace folia::math::cancellation {
+namespace {
+thread_local Request const* activeRequest=nullptr;
+thread_local std::function<void(CheckpointStage)> observer;
+}
+Scope::Scope(Request const& request) noexcept : previous_(activeRequest) { activeRequest=&request; }
+Scope::~Scope() { activeRequest=previous_; }
+void checkpoint(CheckpointStage stage) {
+    if(observer)observer(stage);
+    if(activeRequest)activeRequest->checkpoint();
+}
+testing::CheckpointObserverScope::CheckpointObserverScope(
+    std::function<void(CheckpointStage)> value) : previous_(std::move(observer)) { observer=std::move(value); }
+testing::CheckpointObserverScope::~CheckpointObserverScope() { observer=std::move(previous_); }
+}
