+#include "support/folia_test.hpp"
+import folia.math;
+import folia.math.cancellation;
+
+namespace {
+using namespace boost::ut;
+using folia::math::RenderError;
+using folia::math::Renderer;
+using folia::math::RenderOptions;
+using folia::math::cancellation::CheckpointStage;
+using folia::math::cancellation::testing::CheckpointObserverScope;
+
+std::string errorKind(auto&& action) {
+    try { action(); }
+    catch(const RenderError& error) { return error.name; }
+    throw std::runtime_error("Expected RenderError");
+}
+bool cancelled(auto&& action) {
+    try { action(); }
+    catch(const folia::math::cancellation::Cancelled&) { return true; }
+    return false;
+}
+
+suite math_cancellation_g147 = [] {
+    "brace_initialized_existing_options_calls_remain_unambiguous"_test = [] {
+        Renderer renderer;
+        const auto rendered=renderer.render(u"x",{});
+        expect(!rendered.svg.empty());
+        expect(!renderer.toSvg(u"x",{}).empty());
+        expect(!renderer.render(std::string_view("x"),{}).svg.empty());
+        expect(!renderer.toSvg(std::string_view("x"),{}).empty());
+        expect(!renderer.renderScene(u"x",{}).roots().empty());
+        expect(!renderer.renderScene(std::string_view("x"),{}).roots().empty());
+    };
+    "pre_cancel_and_expired_deadline_leave_session_reusable"_test = [] {
+        Renderer renderer;
+        std::stop_source source; source.request_stop();
+        expect(eq(errorKind([&]{(void)renderer.render(std::string_view("x"),source.get_token(),{});}),std::string("Cancelled")));
+        RenderOptions expired; expired.deadline=std::chrono::steady_clock::now()-std::chrono::milliseconds(1);
+        expect(eq(errorKind([&]{(void)renderer.render(std::string_view("x"),{},expired);}),std::string("Cancelled")));
+        expect(!renderer.render(std::string_view("x")).svg.empty());
+    };
+    "in_flight_cancellation_makes_session_unusable"_test = [] {
+        constexpr std::array stages{CheckpointStage::TeX,CheckpointStage::Layout,CheckpointStage::Scene,CheckpointStage::Serialization};
+        for(const auto target:stages) {
+            Renderer renderer; std::stop_source source; unsigned reached=0;
+            CheckpointObserverScope observer([&](CheckpointStage stage){if(stage==target&&++reached==2)source.request_stop();});
+            expect(eq(errorKind([&]{(void)renderer.render(std::u16string_view(u"\\frac{a}{b}"),source.get_token(),{});}),std::string("Cancelled")));
+            expect(eq(reached,2u));
+            expect(eq(errorKind([&]{(void)renderer.render(std::u16string_view(u"x"));}),std::string("SessionUnusable")));
+            std::stop_source alreadyStopped; alreadyStopped.request_stop();
+            expect(eq(errorKind([&]{(void)renderer.render(std::string_view("x"),alreadyStopped.get_token(),{});}),std::string("SessionUnusable")));
+        }
+    };
+    "deadline_expiring_inside_tex_checkpoint_makes_session_unusable"_test = [] {
+        Renderer renderer; RenderOptions options;
+        options.deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(10);
+        bool waited=false;
+        CheckpointObserverScope observer([&](CheckpointStage stage){if(!waited&&stage==CheckpointStage::TeX){waited=true;std::this_thread::sleep_for(std::chrono::milliseconds(25));}});
+        expect(eq(errorKind([&]{(void)renderer.render(std::u16string_view(u"\\frac{a}{b}"),{},options);}),std::string("Cancelled")));
+        expect(waited);
+        expect(eq(errorKind([&]{(void)renderer.render(std::u16string_view(u"x"));}),std::string("SessionUnusable")));
+    };
+    "nested_scopes_restore_prior_request_and_observer_is_thread_local"_test = [] {
+        using folia::math::cancellation::Request; using folia::math::cancellation::Scope;
+        std::stop_source outerSource; Request outer(outerSource.get_token());
+        { Scope outerScope(outer);
+          std::stop_source innerSource; innerSource.request_stop(); Request inner(innerSource.get_token());
+          { Scope innerScope(inner); expect(cancelled([]{folia::math::cancellation::checkpoint();})); }
+          expect(!cancelled([]{folia::math::cancellation::checkpoint();}));
+          bool otherThreadCancelled=false;
+          std::jthread worker([&]{try{folia::math::cancellation::checkpoint();}catch(const folia::math::cancellation::Cancelled&){otherThreadCancelled=true;}}); worker.join();
+          expect(!otherThreadCancelled);
+          outerSource.request_stop(); expect(cancelled([]{folia::math::cancellation::checkpoint();}));
+        }
+    };
+    "render_scene_cancellation_never_publishes_partial_scene"_test = [] {
+        Renderer renderer;
+        std::stop_source preCancelled; preCancelled.request_stop();
+        expect(eq(errorKind([&]{(void)renderer.renderScene(std::u16string_view(u"x"),preCancelled.get_token(),{});}),std::string("Cancelled")));
+        RenderOptions expired; expired.deadline=std::chrono::steady_clock::now()-std::chrono::milliseconds(1);
+        expect(eq(errorKind([&]{(void)renderer.renderScene(std::string_view("x"),{},expired);}),std::string("Cancelled")));
+        expect(!renderer.renderScene(std::u16string_view(u"x")).roots().empty());
+
+        Renderer active; std::stop_source source; unsigned sceneCheckpoints=0;
+        std::optional<folia::math::output::scene::Scene> unpublished;
+        CheckpointObserverScope observer([&](CheckpointStage stage){
+            if(stage==CheckpointStage::Scene&&++sceneCheckpoints==2)source.request_stop();
+        });
+        expect(eq(errorKind([&]{unpublished.emplace(active.renderScene(std::u16string_view(u"\\frac{a}{b}"),source.get_token(),{}));}),std::string("Cancelled")));
+        expect(!unpublished.has_value());
+        expect(eq(errorKind([&]{(void)active.renderScene(std::string_view("x"),{},{});}),std::string("SessionUnusable")));
+    };
+    "successful_native_results_remain_complete_and_to_svg_matches_render"_test = [] {
+        Renderer renderer;
+        const auto result=renderer.render(std::u16string_view(u"\\frac{a}{b}"));
+        expect(!result.svg.empty()); expect(!result.scene.roots().empty());
+        expect(eq(renderer.toSvg(std::u16string_view(u"\\frac{a}{b}")),result.svg));
+        expect(!renderer.render(std::string_view("\\alpha")).svg.empty());
+    };
+};
+}
